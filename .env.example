# Copy to .env and fill in only what you use. The tests need none of these.

# Model calls: drafts, the post reader, the JD drop, research on the older pages
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
SMALL_MODEL=

# Paid sources: X and LinkedIn through Apify, Exa search, Crustdata
APIFY_TOKEN=
EXA_API_KEY=
CRUSTDATA_API_KEY=
CRUSTDATA_COMPANY_PATH=

# Free sources: a GitHub token raises the rate limit; SEC and OpenAlex ask for a contact
GITHUB_TOKEN=
SEC_USER_AGENT=
OPENALEX_MAILTO=

# Slack: the app's tokens and channel, or the webhooks
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=
SLACK_ROUTING_WEBHOOK=
SLACK_GTM_WEBHOOK=

# Where data lives. Unset, the web app uses data/pilot.sqlite, the timing store
# SOCIAL_DIR/timelines.sqlite, SOCIAL_DIR research/private/social, and the rest
# research/private/ (people file, field file, sending pause) and data/source_cache.
DATABASE_URL=
TIMELINES_DB=
SOCIAL_DIR=
SOURCE_CACHE_DIR=
WATCHLIST=
GI_FIELD=
GI_PAUSE_FILE=
